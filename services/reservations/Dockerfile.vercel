FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /reservations ./cmd/server

FROM alpine:3.22

RUN addgroup -S app && adduser -S -G app -u 10001 app
COPY --from=build /reservations /reservations

USER app
CMD ["/reservations"]
