# This template needs no manually configured environment variables.
#
# RESERVATIONS_SERVICE_URL is injected automatically by Vercel from the
# service binding declared in vercel.json (and by `vercel dev -L` locally).
# Do not set it here or in the Vercel dashboard.
#
# Optional, for running the smoke test against a hosted deployment:
# BASE_URL=https://<deployment-url>
# VERCEL_AUTOMATION_BYPASS_SECRET=<protection-bypass-for-automation secret>
